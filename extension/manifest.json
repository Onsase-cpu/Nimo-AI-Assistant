{
  "manifest_version": 3,
  "name": "Nimo — Voice Assistant",
  "version": "1.0.0",
  "description": "A warm, capable voice assistant for your browser.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://localhost:8080/*", "https://*/*"],
  "action": {"default_popup": "popup.html", "default_title": "Talk to Nimo"}
}
